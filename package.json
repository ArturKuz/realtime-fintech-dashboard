{
  "name": "realtime-fintech-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm build:wasm && ng serve",
    "build": "pnpm build:wasm && ng build",
    "build:pages": "pnpm build:wasm && ng build --base-href /realtime-fintech-dashboard/ && node scripts/copy-404.mjs dist/realtime-fintech-dashboard/browser",
    "build:wasm": "asc wasm/assembly/index.ts --config wasm/asconfig.json --target release",
    "test": "pnpm build:wasm && ng test --watch=false && vitest run --config vitest.wasm.config.ts",
    "test:watch": "ng test",
    "test:wasm": "pnpm build:wasm && vitest run --config vitest.wasm.config.ts",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md,yml,yaml}": "prettier --write"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "assemblyscript": "0.28.20",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.0"
  }
}
